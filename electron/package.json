{
  "name": "tuyere-desktop",
  "version": "1.0.28",
  "description": "Tuyere — AI-powered Infrastructure as Code orchestrator",
  "author": {
    "name": "Tuyere Contributors",
    "email": "avijra@users.noreply.github.com"
  },
  "homepage": "https://github.com/avijra/ansibleForge",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "unset ELECTRON_RUN_AS_NODE && NODE_ENV=development electron dist/main.js",
    "start": "unset ELECTRON_RUN_AS_NODE && electron dist/main.js",
    "package:mac": "electron-builder --mac",
    "package:linux": "electron-builder --linux",
    "package:all": "electron-builder --mac --linux"
  },
  "build": {
    "appId": "ai.tuyere.desktop",
    "productName": "Tuyere",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend",
        "filter": ["**/*"]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "avijra",
      "repo": "ansibleForge"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        },
        {
          "target": "zip",
          "arch": ["arm64"]
        }
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icons",
      "executableName": "tuyere"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.0.0"
  }
}
