{
  "identifier": "default",
  "description": "Default capability granting core and plugin permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-set-focus",
    "core:app:default",
    "core:event:default",
    "core:menu:default",
    "core:tray:default",
    "shell:allow-spawn",
    "shell:allow-execute",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-message",
    "dialog:allow-ask",
    "notification:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "updater:default",
    "deep-link:default",
    "opener:default"
  ]
}
