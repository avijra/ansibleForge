# ── LLM Configuration ──────────────────────────────────────────────
ANSIBLEFORGE_LLM_PROVIDER=deepseek
ANSIBLEFORGE_LLM_MODEL=deepseek/deepseek-chat
ANSIBLEFORGE_LLM_FALLBACK_MODELS=["openai/gpt-4o","ollama/llama3"]

# Provider API keys (set the ones you use)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Ollama (only needed if using ollama provider)
ANSIBLEFORGE_OLLAMA_BASE_URL=http://localhost:11434

# ── Agent Settings ─────────────────────────────────────────────────
ANSIBLEFORGE_MAX_AGENT_STEPS=100
ANSIBLEFORGE_WORKSPACE_DIR=/tmp/ansibleforge
ANSIBLEFORGE_WORKSPACE_TTL_SECONDS=3600

# ── API Settings ───────────────────────────────────────────────────
ANSIBLEFORGE_API_KEY=
ANSIBLEFORGE_HOST=0.0.0.0
ANSIBLEFORGE_PORT=8420
ANSIBLEFORGE_LOG_LEVEL=info                   # debug | info | warning | error
