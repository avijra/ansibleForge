# ── LLM Configuration ──────────────────────────────────────────────
# Recommended models (pick one):
#   anthropic/claude-sonnet-4-20250514  — Best overall (~$1/session)
#   deepseek/deepseek-v4-pro            — Best value (~$0.05-$0.20/session)
#   deepseek/deepseek-v4-flash          — Cheapest (~$0.02/session)
#   openai/gpt-4.1                      — Strong tool calling (~$0.60/session)
#   openai/gpt-4o                       — Proven reliability (~$0.80/session)
#   anthropic/claude-opus-4-20250514    — Maximum quality (~$5/session)
#   zai/glm-5.2                         — Z.AI flagship, 1M context (~$0.10-$0.40/session)
ANSIBLEFORGE_LLM_PROVIDER=
ANSIBLEFORGE_LLM_MODEL=
ANSIBLEFORGE_LLM_FALLBACK_MODELS=
ANSIBLEFORGE_LLM_COMPACTION_MODEL=deepseek/deepseek-v4-flash

# Provider API keys (set the ones you use)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
ZAI_API_KEY=

# Ollama / self-hosted (only needed if using a local model)
ANSIBLEFORGE_OLLAMA_BASE_URL=http://localhost:11434

# Max input tokens per LLM call (0 = no limit). Keeps conversations fast by
# pruning the oldest turns once the budget is reached. The original user goal
# is always preserved via a pinned reminder.
ANSIBLEFORGE_LLM_MAX_CONTEXT_TOKENS=48000
ANSIBLEFORGE_LLM_MODEL_CONTEXT_WINDOW=64000

# ── Web Search ────────────────────────────────────────────────────
# Tavily API key for AI-powered web search with relevance scoring.
# Primary search backend. 1,000 free credits/month.
# Get a key at https://tavily.com/
TAVILY_API_KEY=

# Jina API key for reading JavaScript-rendered pages (fallback search
# and URL scraping). Get a free key at https://jina.ai/
JINA_API_KEY=

# ── Execution Environment ──────────────────────────────────────────
# Enable container-based execution (requires Docker or Podman)
ANSIBLEFORGE_EE_ENABLED=false
# Container image with all Ansible collections and SDKs pre-installed
ANSIBLEFORGE_EE_IMAGE=avijra28/tuyere-ee:latest
# Container runtime: docker or podman
ANSIBLEFORGE_EE_CONTAINER_RUNTIME=docker
# Where the container runs: local (Docker/Podman on this machine) or remote
ANSIBLEFORGE_EE_HOST_MODE=local
# Remote Docker host (user@host) — only used when EE_HOST_MODE=remote
ANSIBLEFORGE_EE_REMOTE_HOST=
# Base directory on the remote host where workspaces are synced
ANSIBLEFORGE_EE_REMOTE_WORKSPACE_ROOT=/var/lib/tuyere/workspaces

# ── Agent Settings ─────────────────────────────────────────────────
ANSIBLEFORGE_MAX_AGENT_STEPS=200
ANSIBLEFORGE_DEFAULT_PROJECT_DIR=

# ── API Settings ───────────────────────────────────────────────────
ANSIBLEFORGE_API_KEY=
ANSIBLEFORGE_HOST=0.0.0.0
ANSIBLEFORGE_PORT=8420
# Log level: debug | info | warning | error
ANSIBLEFORGE_LOG_LEVEL=info
